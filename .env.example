# ─────────────────────────────────────────────────────────────
# Histopathology LIMS — local development environment
# Copy to .env and replace every secret before deploying.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# API
API_PORT=4000
# Railway injects PORT; API_PORT is the local fallback.
# PORT=8080
TRUST_PROXY=1
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api
SWAGGER_ENABLED=true
LOG_LEVEL=info

# Database (replica set is required: scans and accessioning use transactions)
MONGODB_URI=mongodb://localhost:27017/histo_lims?replicaSet=rs0&directConnection=true

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=true

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-000000000000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-00000000000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Generated report PDFs (local disk; mount a volume in production)
STORAGE_DIR=./storage

# Web (Nuxt public runtime config)
NUXT_PUBLIC_API_BASE=http://localhost:4000/api
NUXT_PUBLIC_COOKIE_SECURE=false
NUXT_PUBLIC_APP_NAME=Laboratory LIMS
NUXT_PUBLIC_WEB_BASE=http://localhost:3000

# Referral portal & notifications
PORTAL_DEBUG=true
PORTAL_TOKEN_TTL_MINUTES=15
NOTIFICATIONS_MODE=outbox
# EMAIL_PROVIDER: log | smtp | resend
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_123456789
EMAIL_FROM=no-reply@histopathology.local
SMS_PROVIDER=log
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=
# TERMII_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Asset storage (Cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# Interoperability
FHIR_ENABLED=true
HL7_ENABLED=false
HL7_MLLP_PORT=2575
HL7_LAB_CODE=HISTO
# HL7_ALLOWED_IPS=10.0.0.10,10.0.0.11
# WSI_WEBHOOK_SECRET=replace-with-a-32-character-secret

# Payments (mock for local; live requires provider keys)
PAYMENTS_MODE=mock
DEFAULT_CURRENCY=NGN
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=

# Seed
SEED_RESET=false

# Instrument connector agent
LIMS_URL=http://localhost:4000/api
LIMS_LAB_CODE=HISTO
# LIMS_EMAIL=
# LIMS_PASSWORD=
