{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "declaration": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node", "jest"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@lims/shared": ["./shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "shared/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
