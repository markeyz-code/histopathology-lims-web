# Railway API service environment.
NODE_ENV=production
PORT=8080
API_PREFIX=api
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
PUBLIC_WEB_URL=https://YOUR-FRONTEND.vercel.app
PUBLIC_API_URL=https://YOUR-API.up.railway.app/api
SWAGGER_ENABLED=false
LOG_LEVEL=info
TRUST_PROXY=1

# MongoDB must be a replica set (Atlas recommended) because accessioning/custody use transactions.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/histo_lims?retryWrites=true&w=majority
REDIS_URL=redis://default:PASSWORD@HOST:6379
QUEUES_ENABLED=true

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Railway persistent volume mounted at /data.
STORAGE_DIR=/data/storage

# Notifications — switch to live only after SMTP/WhatsApp/templates are verified.
PORTAL_DEBUG=false
NOTIFICATIONS_MODE=outbox
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@YOUR-DOMAIN
SMS_PROVIDER=log
PORTAL_TOKEN_TTL_MINUTES=15

# Interoperability
FHIR_ENABLED=true
HL7_ENABLED=false
HL7_MLLP_PORT=2575
HL7_LAB_CODE=HISTO
# WSI_WEBHOOK_SECRET=
# HL7_ALLOWED_IPS=

# Payments — keep mock until live provider onboarding is complete.
PAYMENTS_MODE=mock
DEFAULT_CURRENCY=NGN
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=

SEED_RESET=false
