{
  "name": "@lims/api",
  "version": "1.0.0",
  "private": true,
  "description": "Histopathology LIMS API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "seed": "ts-node src/seed/run-seed.ts",
    "seed:reset": "SEED_RESET=true ts-node src/seed/run-seed.ts"
  },
  "dependencies": {
    "@lims/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "bwip-js": "4.11.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "compression": "1.8.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.6",
    "nestjs-pino": "5.3.1",
    "nodemailer": "^10.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
